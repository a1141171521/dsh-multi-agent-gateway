{
  "name": "dsh-multi-agent-gateway",
  "version": "0.4.0",
  "description": "多 Agent 通用 API 反代网关 Provider 插件：统一账号管理 / 自动签到 / 额度拉取 / 活动任务 / 多账号智能路由 / 模型分组与积分倍率，对 DSH 暴露 OpenAI 兼容流式 Completion 接口；并附带 generate_image 文字生图工具。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "vendor",
    "lib",
    "src",
    "docs",
    "cordis.patch.yml",
    "plugin.json",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "llm-provider",
    "gateway",
    "opencode",
    "qoder",
    "trae",
    "workbuddy",
    "multi-account",
    "raccoon",
    "xiaohuanxiong"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "scan": "node scripts/scan-secrets.mjs",
    "test": "node --test test/unit.test.mjs test/quota-refresh.test.mjs test/request-log-sampling.test.mjs test/account-gate.test.mjs test/adapters/qoder.test.mjs test/adapters/buddy.test.mjs test/adapters/buddy-error.test.mjs test/adapters/opencode.test.mjs test/adapters/trae.test.mjs test/adapters/raccoon.test.mjs test/reasoning.test.mjs test/checkin-accounting.test.mjs test/channel-guard.test.mjs test/imagegen.test.mjs && node test/client.test.mjs && node test/smoke.mjs",
    "test:unit": "node --test test/unit.test.mjs",
    "test:adapters": "node --test test/adapters/qoder.test.mjs test/adapters/buddy.test.mjs test/adapters/buddy-error.test.mjs test/adapters/opencode.test.mjs test/adapters/trae.test.mjs test/adapters/raccoon.test.mjs",
    "test:channel-guard": "node --test test/channel-guard.test.mjs",
    "test:reasoning": "node --test test/reasoning.test.mjs",
    "test:checkin": "node --test test/checkin-accounting.test.mjs",
    "test:quota": "node --test test/quota-refresh.test.mjs",
    "test:sampling": "node --test test/request-log-sampling.test.mjs",
    "test:account-gate": "node --test test/account-gate.test.mjs",
    "test:client": "node test/client.test.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:load": "node test/live-load.mjs",
    "test:live": "node test/live-opencode.mjs",
    "test:free": "node test/live-freetier.mjs",
    "test:live:raccoon": "node test/live-raccoon.mjs",
    "test:demo": "node test/demo-pipeline.mjs",
    "test:login": "node test/live-login.mjs",
    "test:e2e": "node test/e2e-login.mjs",
    "test:login:opencode": "node test/live-login-opencode.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-store"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.5-rc.1"
  }
}
