{
  "id": "dsh-multi-agent-gateway",
  "name": "免费模型聚合器",
  "version": "0.1.0",
  "main": "./lib/index.js",
  "type": "provider",
  "description": "把其他平台的免费模型接进 DSH：统一账号管理 / 自动签到 / 额度拉取 / 活动任务 / 多账号智能路由；模型按平台分组进原生选择器并标注积分倍率。",
  "engines": {
    "dsh": ">=0.1.5-rc.1",
    "node": ">=20"
  },
  "client": {
    "main": "./lib/client.js",
    "platform": "web"
  },
  "settings": {
    "namespace": "dsh-multi-agent-gateway",
    "rowKey": "dsh-multi-agent-gateway#dsh-multi-agent-gateway"
  },
  "contributes": {
    "llmProviders": [
      {
        "provider": "multiagent-opencode",
        "displayName": "OpenCode",
        "agentId": "opencode",
        "implemented": true
      },
      {
        "provider": "multiagent-qoder",
        "displayName": "Qoder",
        "agentId": "qoder",
        "implemented": true
      },
      {
        "provider": "multiagent-qoder-cn",
        "displayName": "Qoder CN",
        "agentId": "qoder-cn",
        "implemented": true
      },
      {
        "provider": "multiagent-trae",
        "displayName": "Trae",
        "agentId": "trae",
        "implemented": true
      },
      {
        "provider": "multiagent-workbuddy",
        "displayName": "WorkBuddy",
        "agentId": "workbuddy",
        "implemented": true
      },
      {
        "provider": "multiagent-workbuddy-intl",
        "displayName": "WorkBuddy International",
        "agentId": "workbuddy-intl",
        "implemented": true
      }
    ],
    "tools": [
      "multiagent_accounts",
      "multiagent_quota",
      "multiagent_checkin",
      "multiagent_tasks",
      "multiagent_routing"
    ],
    "skills": []
  },
  "storage": {
    "root": "<DSH_HOME>/multi-agent-gateway",
    "files": {
      "state": "state.json",
      "accounts": "accounts.enc.json",
      "key": ".master-key",
      "tasks": "task-log.jsonl"
    }
  }
}
